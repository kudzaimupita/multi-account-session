{
  "name": "multi-account-session",
  "version": "0.1.0",
  "description": "Several accounts signed in at once: account chooser, per-tab switching and per-account sign-out behind one sealed cookie",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    "./testing": {
      "types": "./dist/testing/store-conformance.d.ts",
      "default": "./dist/testing/store-conformance.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "example": "node examples/express-app/server.ts"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
